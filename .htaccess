# Desativa ModSecurity para crawlers de redes sociais
<IfModule mod_security.c>
    <If "%{HTTP_USER_AGENT} =~ /facebookexternalhit|Facebot|Twitterbot|WhatsApp|LinkedInBot/">
        SecRuleEngine Off
    </If>
</IfModule>

# Libera acesso para crawlers de redes sociais
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_USER_AGENT} facebookexternalhit [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Facebot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Twitterbot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} LinkedInBot [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} WhatsApp [NC]
    RewriteRule .* - [L]
</IfModule>

# Cache para imagens og-image
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 week"
</IfModule>
